{#- Post cards. Set `postslist`; optional `headingLevel` (default 2). -#}
{%- set hl = headingLevel or 2 %}
{%- for post in postslist | reverse %}
<div class="card mb-3">
  <div class="card-body">
    <h{{ hl }} class="card-title h3">
      <a href="{{ post.url }}" class="post-title-link">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
    </h{{ hl }}>
    <p class="card-text mb-0">
      <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("dd LLLL yyyy") }}</time>
    </p>
    {% if post.data.excerpt or post.data.description %}
    <p class="card-text mt-2">{{ post.data.excerpt or post.data.description | truncate(200) }}</p>
    {% endif %}
  </div>
  {%- set postTopics = post.data.topics | topicsOf(post.inputPath) %}
  {% if postTopics.length or post.data.type %}
  <div class="card-footer bg-transparent d-flex flex-wrap gap-2 align-items-center">
    {% if post.data.type %}<span class="post-type">{{ post.data.type | postTypeLabel(post.inputPath) }}</span>{% endif %}
    {% for t in postTopics %}<a href="{{ t.path }}" class="tag" style="{{ t.name | getTagStyle }}">{{ t.label }}</a>{% endfor %}
  </div>
  {% endif %}
</div>
{%- endfor %}
