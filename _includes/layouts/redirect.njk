<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Moved: {{ redirectTitle or target }}</title>
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ target | htmlBaseUrl(metadata.url) }}">
<meta http-equiv="refresh" content="0; url={{ target }}">
</head>
<body>
<p>This page has moved to <a href="{{ target }}">{{ redirectTitle or target }}</a>.</p>
</body>
</html>
