---
layout: layouts/base.njk
---
{# Only include the syntax highlighter CSS on blog posts, included with the CSS per-page bundle #}
<style>{% include "node_modules/prismjs/themes/prism-okaidia.css" %}</style>
<style>{% include "css/prism-diff.css" %}</style>

<article class="mb-5">
  <header class="mb-4">
    <h1 class="display-4">{{ title }}</h1>
    
    <div class="mb-3">
      <small>
        Posted on <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
        {% if author %} by {{ author }}{% endif %}
      </small>
    </div>
    
    {% if tags.length %}
    <div class="mb-3">
      {% for tag in tags | filterTagList %}
      {% set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
      <a href="{{ tagUrl }}" class="badge me-2" style="{{ tag | getTagStyle }}">{{ tag }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </header>

  <div class="content">
    {{ content | safe }}
  </div>

  {% if collections.blog %}
  {% set previousPost = collections.blog | getPreviousCollectionItem %}
  {% set nextPost = collections.blog | getNextCollectionItem %}
  {% if nextPost or previousPost %}
  <nav aria-label="Post navigation" class="mt-5">
    <ul class="pagination flex-column flex-md-row justify-content-center">
      {% if previousPost %}
      <li class="page-item">
        <a class="page-link" href="{{ previousPost.url }}">
          {% icon "arrow-left" %} Previous: {{ previousPost.data.title }}
        </a>
      </li>
      {% endif %}
      {% if nextPost %}
      <li class="page-item">
        <a class="page-link" href="{{ nextPost.url }}">
          Next: {{ nextPost.data.title }} {% icon "arrow-right" %}
        </a>
      </li>
      {% endif %}
    </ul>
  </nav>
  {% endif %}
  {% endif %}
</article>

{# Giscus comments, loaded only after a click: no request to giscus.app or
   GitHub before the visitor asks for it. Settings are unchanged (mapping by
   title, so don't rename published posts). #}
<section class="comments mt-5 pt-4 border-top border-secondary" aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="h4">Comments</h2>
  <div id="comments-consent">
    <p class="mb-3">Comments are provided by <a href="https://giscus.app">giscus</a> and stored as GitHub Discussions. Loading them connects your browser to giscus.app and GitHub, Inc. in the <strong>USA</strong> and transfers your IP address and browser data there. The USA does not have a level of data protection equivalent to the EU's; US authorities may access the data. By clicking the button, you consent to this transfer (Art. 49(1)(a) GDPR). Details: <a href="/privacy/#comments">privacy policy, section 5</a>.</p>
    <button type="button" class="btn btn-primary" id="load-comments">{% icon "chat-dots" %} Load comments</button>
  </div>
  <div class="giscus"></div>
</section>
<script>
document.getElementById("load-comments")?.addEventListener("click", () => {
  const s = document.createElement("script");
  s.src = "https://giscus.app/client.js";
  Object.entries({
    repo: "lod-am/website", repoId: "R_kgDOTERevg",
    category: "Comments", categoryId: "DIC_kwDOTERevs4DAFDJ",
    mapping: "title", strict: "0", reactionsEnabled: "1", emitMetadata: "0",
    inputPosition: "bottom", theme: "gruvbox_dark", lang: "en", loading: "lazy",
  }).forEach(([k, v]) => { s.dataset[k] = v; });
  s.crossOrigin = "anonymous";
  s.async = true;
  document.getElementById("comments-consent").remove();
  document.querySelector(".comments").appendChild(s);
});
</script>

