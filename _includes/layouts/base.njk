<!doctype html>
<html lang="{{ metadata.language }}" data-bs-theme="dark">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ title or metadata.title }}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
		<link rel="canonical" href="{{ page.url | htmlBaseUrl(metadata.url) }}" />
		{%- if record and record.files %}
		<link rel="alternate" type="text/turtle" href="{{ record.files.ttl }}">
		<link rel="alternate" type="application/ld+json" href="{{ record.files.jsonld }}">
		{%- endif %}

		<!-- Mastodon verification -->
		<link rel="me" href="https://archaeo.social/@FabianF">

		<!-- OpenGraph / Social Media Meta Tags -->
		<meta property="og:title" content="{{ title or metadata.title }}">
		<meta property="og:description" content="{{ description or metadata.description }}">
		<meta property="og:url" content="{{ page.url | htmlBaseUrl(metadata.url) }}">
		{%- set isPost = page.inputPath and page.inputPath.includes('/blog/') and page.fileSlug != "blog" %}
		<meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
		{%- if isPost %}
		<meta property="article:published_time" content="{{ page.date | htmlDateString }}">
		{%- endif %}
		<meta property="og:image" content="{{ '/img/logo.png' | htmlBaseUrl(metadata.url) }}">
		<meta property="og:image:alt" content="LOD-AM logo">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="{{ title or metadata.title }}">
		<meta name="twitter:description" content="{{ description or metadata.description }}">
		<meta name="twitter:image" content="{{ '/img/logo.png' | htmlBaseUrl(metadata.url) }}">

		<!-- Fediverse creator attribution for blog posts -->
		{% if isPost %}
		<meta name="fediverse:creator" content="@FabianF@archaeo.social">
		{% endif %}

		<!-- schema.org metadata (JSON-LD) -->
		{%- if isPost %}
		<script type="application/ld+json" eleventy:ignore>{{ { title: title, description: description, topics: topics, about: about, updated: updated } | jsonLdPost(page, page.rawInput) | safe }}</script>
		{%- elif page.url == "/" %}
		<script type="application/ld+json" eleventy:ignore>{{ "" | jsonLdSite | safe }}</script>
		{%- endif %}

		<!-- Favicon -->
		<link rel="icon" type="image/x-icon" href="/img/favicon.ico">
		<link rel="icon" type="image/png" href="/img/logo.svg">

		<!-- Bootstrap, then the LOD-AM theme (dark mode + palette) -->
		<link rel="stylesheet" href="/css/bootstrap.min.css">
		<link rel="stylesheet" href="/css/theme.css">
		<!-- Per-page CSS bundle (e.g. syntax highlighting on posts) -->
		<style>{% getBundle "css" %}</style>

	</head>
	<body class="d-flex flex-column min-vh-100">
		<a href="#main" id="skip-link" class="visually-hidden-focusable">Skip to main content</a>

		<!-- Bootstrap Navbar -->
		<nav class="navbar navbar-expand-lg site-nav" data-bs-theme="dark">
			<div class="container">
				<a class="navbar-brand" href="/">
					<img src="/img/logo.svg" alt="{{ metadata.title }}: home" width="75" height="75" class="d-inline-block align-top" eleventy:ignore>
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="mainNav">
					<ul class="navbar-nav me-auto">
					{%- for entry in collections.all | eleventyNavigation %}
						{%- if entry.key == "Data" %}
						{#- Data: dropdown with the overview and the kinds of records that exist (website#14) #}
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" href="{{ entry.url }}" role="button" data-bs-toggle="dropdown" aria-expanded="false"{% if page.url.startsWith("/data/") or page.url.startsWith("/id/") %} aria-current="true"{% endif %}>{{ entry.title }}</a>
							<ul class="dropdown-menu">
								<li><a class="dropdown-item" href="{{ entry.url }}">Overview</a></li>
								<li><hr class="dropdown-divider"></li>
								{%- for key in ["site", "find", "analysis", "type", "period", "culture"] %}
								{%- if lodam.byKind[key].length %}
								<li><a class="dropdown-item" href="/data/{{ lodam.KINDS[key].slug }}/">{{ lodam.KINDS[key].plural }}</a></li>
								{%- endif %}
								{%- endfor %}
								<li><a class="dropdown-item" href="/data/publications/">Publications</a></li>
							</ul>
						</li>
						{%- else %}
						<li class="nav-item">
							<a class="nav-link" href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a>
						</li>
						{%- endif %}
					{%- endfor %}
					</ul>
				</div>
			</div>
		</nav>

		<main id="main" class="flex-grow-1">
			<div class="container py-4">
				<heading-anchors>
					{{ content | safe }}
				</heading-anchors>
			</div>
		</main>

		<!-- Bootstrap Footer -->
		<footer class="site-footer py-4 mt-auto text-center">
			<div class="container">
				<nav aria-label="Footer" class="footer-links small mb-2">
					<a href="/impressum/">Impressum</a>
					<a href="/privacy/">Privacy Policy</a>
					<a href="/feed/feed.xml">Feed (Atom)</a>
					<a href="https://github.com/LOD-AM/website">GitHub</a>
					<a rel="me" href="https://archaeo.social/@FabianF">Mastodon</a>
				</nav>
				<p class="mb-1 small">
					<a href="https://github.com/LOD-AM/website">LOD-AM Website</a> &copy; 2026 by <a href="https://lod-am.net">{{ metadata.author.name }}</a> is licensed under
					<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
					<img src="/img/cc/cc.svg" alt="" width="16" height="16" class="cc-icon" eleventy:ignore>
					<img src="/img/cc/by.svg" alt="" width="16" height="16" class="cc-icon" eleventy:ignore>
				</p>
				<p class="mb-0 small">Built with <a href="https://www.11ty.dev/">{{ eleventy.generator }}</a></p>
			</div>
		</footer>

		<!-- Bootstrap JS Bundle with Popper -->
		<script src="/js/bootstrap.bundle.min.js"></script>
		<script type="module" src="{% getBundleFileUrl "js" %}"></script>
	</body>
</html>
