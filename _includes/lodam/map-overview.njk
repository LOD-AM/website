{#- Overview of the whole map area with all released sites (planning#18). Uses lodam.maps. -#}
{%- set m = lodam.maps %}
<figure class="site-map site-map--overview mb-0" aria-labelledby="map-overview-cap">
  <div class="site-map__frame" style="aspect-ratio: {{ m.overview.width }} / {{ m.overview.height }}">
    <img src="{{ m.overview.src }}" width="{{ m.overview.width }}" height="{{ m.overview.height }}" loading="lazy" decoding="async"
      alt="Relief map of the LOD-AM area ({{ m.extent.west }}–{{ m.extent.east }}° E, {{ m.extent.south }}–{{ m.extent.north }}° N) with rivers and natural lakes; marked: {% for x in m.sites %}{{ x.label }}{% if not loop.last %}, {% endif %}{% endfor %}." eleventy:ignore>
    {%- for x in m.sites %}
    <a class="site-map__marker" href="{{ x.path }}" style="left: {{ x.left | round(3) }}%; top: {{ x.top | round(3) }}%">
      <span class="site-map__dot" aria-hidden="true"></span><span class="site-map__label">{{ x.label }}</span>
    </a>
    {%- endfor %}
  </div>
  <figcaption id="map-overview-cap" class="small text-body-secondary mt-2">
    The area of the LOD-AM research database, {{ m.extent.west }}–{{ m.extent.east }}° E, {{ m.extent.south }}–{{ m.extent.north }}° N,
    with the released sites. Rivers, natural lakes and coastlines as today. Sources: <a href="/data/#map-sources">map data</a>.
  </figcaption>
</figure>
