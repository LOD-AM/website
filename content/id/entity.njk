---
pagination:
  data: lodam.records
  size: 1
  alias: record
  addAllPagesToCollections: true
permalink: "{{ record.path }}"
eleventyComputed:
  title: "{{ record.label | safe }} · {{ record.kindLabel }} · LOD-AM"
  description: "{{ record.description | safe }}"
---
<div class="entity" data-pagefind-body data-pagefind-filter="kind:{{ record.kindLabel }}">
  <nav aria-label="Breadcrumb" class="small mb-2" data-pagefind-ignore>
    <a href="/data/">Data</a> › <a href="/data/{{ lodam.KINDS[record.kind].slug }}/">{{ lodam.KINDS[record.kind].plural }}</a>
  </nav>
  {%- set entity = { kindLabel: record.kindLabel, label: record.label, summary: record.summary, icon: "/img/" + record.kind + "-logo.svg" } %}
  {% include "lodam/header.njk" %}

  {%- set facts = record.facts %}
  {% include "lodam/facts.njk" %}

  {%- if record.map %}
  <section class="mt-4" aria-labelledby="map-heading">
    <h2 id="map-heading" class="h4">Map</h2>
    {%- set currentIri = record.iri %}
    {% include "lodam/map.njk" %}
  </section>
  {%- endif %}

  {% for s in record.sections %}{% if not s.tech %}
  <section class="mt-4" aria-labelledby="s{{ loop.index }}">
    <h2 id="s{{ loop.index }}" class="h4">{{ s.heading }}{% if s.list or s.count %} <span class="text-body-secondary fs-6">({{ s.count or s.list.length }})</span>{% endif %}</h2>
    {% if s.caption %}<p class="small text-body-secondary">{{ s.caption }}</p>{% endif %}
    {% if s.list %}
    <ul class="entity-list">
      {%- for v in s.list %}<li>{% include "lodam/value.njk" %}</li>{% endfor %}
    </ul>
    {% elif s.table %}
    {%- set t = s.table %}{% set tid = "s" + loop.index %}
    {% include "lodam/table.njk" %}
    {% endif %}
  </section>
  {% endif %}{% endfor %}

  {%- set posts = collections.blog | postsAbout(record.iri) %}
  {% if posts.length %}
  <section class="mt-4" aria-labelledby="posts-about">
    <h2 id="posts-about" class="h4">Blog posts about this {{ record.kindLabel | lower }}</h2>
    <ul class="entity-list">{% for p in posts | reverse %}<li><a href="{{ p.url }}">{{ p.data.title }}</a> <span class="text-body-secondary small">({{ p.date | readableDate("dd LLLL yyyy") }})</span></li>{% endfor %}</ul>
  </section>
  {% endif %}

  {% include "lodam/cite.njk" %}

  {%- set tech = { iri: record.iri, facts: record.tech, sections: record.sections } %}
  {% include "lodam/technical.njk" %}

  <p class="small text-body-secondary mt-5">Data released by the author under CC BY 4.0. Modelling: <a href="https://github.com/LOD-AM/knowledge-graph/blob/main/CONVENTIONS.md">LOD-AM conventions</a>.</p>
</div>
