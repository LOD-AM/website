---
eleventyNavigation:
  key: "Blog"
  order: 2
---
	<div class="row">
		<div class="col-lg-8">
			<h1 class="display-4 mb-4">Blog</h1>
			<p class="lead mb-4">All {{ collections.blog | length }} posts · <a href="/feed/feed.xml">subscribe via Atom feed</a></p>
			
			{% set postslist = collections.blog %}
			{% include "bloglist.njk" %}
		</div>
		
		<div class="col-lg-4">
			{% set seriesId = "building-lod-am" %}
			{% include "start-here.njk" %}
			<div class="card mb-4">
				<div class="card-header">
					<h2 class="h5 mb-0">Topics</h2>
				</div>
				<div class="card-body">
					{% for t in topicVocab.topics %}
					{%- set n = collections.blog | postsWithTopic(t.name) | length %}
					{%- if n %}
					<a href="{{ t.path }}" class="tag m-1" style="{{ t.name | getTagStyle }}">{{ t.label }} <span class="tag__count">{{ n }}</span></a>
					{%- endif %}
					{% endfor %}
					<p class="small mt-2 mb-0"><a href="/topics/">All topics</a></p>
				</div>
			</div>
		</div>
	</div>
