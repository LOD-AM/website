---
pagination:
  data: lodam.KINDS
  size: 1
  alias: kind
permalink: "/data/{{ lodam.KINDS[kind].slug }}/"
eleventyComputed:
  title: "{{ lodam.KINDS[kind].plural }} · LOD-AM data"
  description: "All {{ lodam.KINDS[kind].plural | lower }} in the released LOD-AM data."
---
{%- set k = lodam.KINDS[kind] %}
{%- set items = lodam.byKind[kind] %}
<div class="reading-column ms-0">
  <nav aria-label="Breadcrumb" class="small mb-2"><a href="/data/">Data</a></nav>
  <h1 class="mb-3 d-flex align-items-center gap-3"><img src="/img/{{ kind }}-logo.svg" alt="" width="56" height="56" class="entity-icon entity-icon--list" eleventy:ignore>{{ k.plural }}</h1>
  <p class="lead">{{ items.length }} {{ (k.plural if items.length != 1 else k.singular) | lower }} in the released data.</p>
  {%- if kind == "site" and lodam.maps and lodam.maps.sites.length %}
  <section class="mb-4" aria-labelledby="map-overview">
    <h2 id="map-overview" class="h5">Map</h2>
    {%- set currentIri = false %}
    {% include "lodam/map.njk" %}
  </section>
  <h2 class="h5">All sites</h2>
  {%- endif %}
  <ul class="entity-list">
    {%- for r in items %}
    <li><a href="{{ r.path }}">{{ r.label }}</a></li>
    {%- else %}
    <li>None yet.</li>
    {%- endfor %}
  </ul>
</div>
