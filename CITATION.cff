    website: "https://lod-am.net/about/"
repository-code: "https://github.com/LOD-AM/website"
url: "https://lod-am.net/"
license: CC-BY-4.0
keywords:
  - Linked Open Data
  - archaeometallurgy
  - research data management
  - Eleventy
